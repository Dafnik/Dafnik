---
import {Icon} from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderText from '../components/HeaderText.astro';

const socialLinks = [
  {label: 'github', href: 'https://github.com/Dafnik', icon: 'social/github'},
  {label: 'blog', href: '/blog', icon: 'blog', internal: true},
  {label: 'mastodon', href: 'https://fedi.at/@dafnik', icon: 'social/mastodon'},
  {label: 'email', href: 'mailto:contact+AT+dafnik.me', icon: 'social/email'},
  {label: 'gitlab', href: 'https://gitlab.com/Dafnik', icon: 'social/gitlab'},
  {label: 'imprint', href: '/imprint', icon: 'social/imprint', internal: true},
];

const projectGroups = [
  {
    title: '> project',
    items: [
      {label: 'kellner.team', href: 'https://kellner.team'},
      {label: 'poweruptime', href: 'https://poweruptime.org'},
      {label: 'DatePoll', href: 'https://datepollsystems.org/projects/datepoll'},
    ],
  },
  {
    title: '< projects',
    items: [
      {label: 'dfx-qrcode', href: 'https://npmx.dev/package/dfx-qrcode'},
      {label: 'dfx-openapi', href: 'https://npmx.dev/package/dfx-openapi'},
      {label: 'dfx-theme', href: 'https://npmx.dev/package/dfx-theme'},
      {label: 'dfx-transloco-markup', href: 'https://npmx.dev/package/dfx-transloco-markup'},
      {label: 'dfx-opa', href: 'https://npmx.dev/package/dfx-opa'},
      {label: 'dfx-bootstrap-table', href: 'https://npmx.dev/package/dfx-bootstrap-table'},
      {label: 'year progress bot', href: 'https://fedi.at/@year_progress'},
    ],
  },
  {
    title: 'other stuff',
    items: [
      {label: 'screenshot editor', href: 'https://screenshot-editor.dafnik.me'},
      {label: 'meta', href: '/meta', internal: true},
      {label: 'status monitor', href: 'https://status.dafnik.me'},
      {label: 'releases.datepoll.org', href: 'https://releases.datepoll.org'},
    ],
  },
];
---

<BaseLayout>
  <main class="flex flex-col gap-10 sm:gap-14">
    <header class="flex flex-col gap-7">
      <HeaderText />
    </header>

    <nav
      class="grid gap-5 border-y border-[var(--line)] py-6 sm:grid-cols-[10rem_1fr] sm:items-start"
      aria-label="Elsewhere on the web">
      <span class="font-mono text-[0.8rem] tracking-[0.04em] text-[var(--muted)]">// find me</span>
      <div class="flex flex-wrap gap-x-6 gap-y-4">
        {
          socialLinks.map((link) => (
            <a
              class="relative inline-flex items-center gap-2 font-mono text-sm text-[var(--paper)] after:pointer-events-none after:absolute after:bottom-[-4px] after:left-1/2 after:h-0 after:w-[calc(100%+12px)] after:-translate-x-1/2 after:bg-white after:mix-blend-exclusion after:transition-all after:duration-[180ms] after:ease-[cubic-bezier(0.445,0.05,0.55,0.95)] after:will-change-[height] hover:after:h-[calc(100%+8px)]"
              href={link.href}
              target={link.internal ? undefined : '_blank'}
              rel={
                link.internal ? undefined : link.label === 'mastodon' ? 'me noopener' : 'noopener'
              }>
              <span>{link.label}</span>
              <Icon class="size-4" name={link.icon} aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </nav>

    <section class="grid gap-x-16 gap-y-14 md:grid-cols-2" aria-label="Projects and links">
      {
        projectGroups.map((group, index) => (
          <section class="pt-5">
            <h2 class="text-2xl tracking-[-0.04em] sm:text-3xl">{group.title}</h2>
            <ol class="ms-8 mt-7 [list-style-type:cjk-ideographic] space-y-2.5 font-mono">
              {group.items.map((item) => (
                <li>
                  <a
                    class="relative inline-block max-w-full text-base break-words text-[var(--paper)] after:pointer-events-none after:absolute after:bottom-[-4px] after:left-1/2 after:h-0 after:w-[calc(100%+12px)] after:-translate-x-1/2 after:bg-white after:mix-blend-exclusion after:transition-all after:duration-[180ms] after:ease-[cubic-bezier(0.445,0.05,0.55,0.95)] after:will-change-[height] hover:after:h-[calc(100%+8px)]"
                    href={item.href}
                    target={item.internal ? undefined : '_blank'}
                    rel={item.internal ? undefined : 'noopener'}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </section>
  </main>
</BaseLayout>

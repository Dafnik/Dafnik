<a href="/" class="block w-fit" aria-label="Back to the home page">
  <span class="text-[clamp(2rem,6vw,3.5rem)] leading-none tracking-[-0.055em]">Hi! I'm</span>
  <span
    id="name-big"
    class="mx-1 block text-[clamp(4.25rem,17vw,9rem)] leading-[0.82] tracking-[-0.09em] sm:inline">
    Dominik
  </span>
  <span class="block text-[clamp(2rem,6vw,3.5rem)] leading-none tracking-[-0.055em] sm:inline">
    or you maybe know me as Dafnik.
  </span>
</a>

<script>
  document.addEventListener('astro:page-load', () => {
    const nameBig = document?.getElementById('name-big');
    const rainbowClasses = [
      'bg-[linear-gradient(to_right,red,orange,yellow,green,cyan,blue,violet)]',
      'bg-clip-text',
      'text-transparent',
    ];

    if (nameBig) {
      nameBig.classList.remove(...rainbowClasses);
      if (new Date().getMonth() === 5) {
        nameBig.classList.add(...rainbowClasses);
      } else {
        const colors = [
          '#AED581',
          '#8BC34A',
          '#1DE9B6',
          '#29B6F6',
          '#40C4FF',
          '#BBDEFB',
          '#42A5F5',
          '#B39DDB',
          '#4DB6AC',
          '#81D4FA',
          '#EF9A9A',
          '#F4FF81',
          '#CCFF90',
          '#FFC107',
          '#FF3D00',
          '#18FFFF',
        ];
        const accent = colors[Math.floor(Math.random() * colors.length)];
        nameBig.style.color = accent;
        document.documentElement.style.setProperty('--accent', accent);
      }
    }
  });
</script>
